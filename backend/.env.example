# ---- Database ----
# "mysql" for the real deployment, "sqlite" for zero-setup local dev/testing
DB_ENGINE=mysql

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=revenue_recovery

# Only used when DB_ENGINE=sqlite
SQLITE_PATH=db/revenue_recovery.sqlite3

# ---- AI (optional) ----
# Leave blank to automatically use the deterministic fallback advisor.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Payments ----
# "mock" = Synthetic Mode (default, no external calls)
# "razorpay_test" = real Razorpay Test Mode API calls
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Guardrails ----
MAX_RETRIES=2
RETRY_COOLDOWN_MINUTES=15
HIGH_VALUE_THRESHOLD=50000
MAX_NOTIFICATIONS=3
RECOVERY_KILL_SWITCH=false

# ---- Flask ----
SECRET_KEY=change-this-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
